# ─────────────────────────────────────────────────────────────────────────────
# Segredos do OREIA-SECA. Copie para .env (o `make bootstrap` faz isso e preenche
# o que dá para gerar sozinho). NUNCA faça commit do .env.
# ─────────────────────────────────────────────────────────────────────────────

# Telegram (crie o bot com o @BotFather)
TELEGRAM_TOKEN=
# Seu ID numérico; se não souber, mande uma mensagem ao bot e ele responde com o ID
TELEGRAM_ALLOWED=

# Token Bearer da API REST (/api/*). Gerado pelo bootstrap.
REST_API_KEY=

# ── Portas (mude se já tiver algo usando estas nesta máquina) ───────────────
FORGEJO_HTTP_PORT=3000
FORGEJO_SSH_PORT=2222
OREIA_SECA_PORT=3120
PX0_PORT=7777
# Mesmos repositórios de [forgejo].repos no oreia-seca.toml, dono/repo separados por vírgula.
FORGEJO_REPOS=
# Contas do Forgejo autorizadas a entrar no px0 (usuário, separados por vírgula). Vazio = ninguém.
PX0_ALLOWED_USERS=
# Preenchidos pelo bootstrap (app OAuth2 "oreia-seca-px0" no Forgejo) — login único em vez de senha.
PX0_OAUTH_CLIENT_ID=
PX0_OAUTH_CLIENT_SECRET=

# ── LLM externo ──────────────────────────────────────────────────────────────
# Preenchido por "make llm-setup" (assistente interativo). Aponta para um
# servidor compatível com /v1/chat/completions rodando em outra máquina, no
# seu computador (LM Studio) ou numa API (OpenRouter) — veja docs/modelos-locais.md.
# LLM_CODER_URL=http://<ip>:11434/v1       # usado por planner, dev-*, executor
# LLM_CODER_MODEL=qwen2.5-coder:14b
# LLM_CHAT_URL=http://<ip>:11434/v1        # usado pela conversa direta (direct)
# LLM_CHAT_MODEL=llama3.1:8b
# LLM_API_KEY=                             # só se o servidor exigir (OpenRouter, etc.)

# Modelos remotos (opcionais, para exemplos específicos em oreia-seca.example.toml)
OPENROUTER_KEY=
GEMINI_KEY=
ANTHROPIC_API_KEY=                       # API nativa da Anthropic (console.anthropic.com), para [models.claude]

# ── Containers por executor (opcional) ────────────────────────────────────────
# Só necessário se você configurar `container` em [executors.<nome>] no
# oreia-seca.toml (ex. pra rodar opencode/codex em imagem própria, em vez de
# dentro do container do orquestrador). Veja
# docs/executores.md#containers-por-executor e docker-compose.override.example.yml.
# DOCKER_GID=                              # getent group docker | cut -d: -f3, no HOST
# OREIA_SECA_HOST_DIR=                     # caminho ABSOLUTO deste repositório no HOST

# ── Depuração (opcional) ──────────────────────────────────────────────────────
# Desligado por padrão: loga o corpo completo de requisições/respostas aos
# modelos (nunca a chave) — útil pra entender respostas estranhas, mas não
# deixe ativado em produção. Precisa de RUST_LOG=oreia_llm=debug (ou mais
# amplo) também, senão os debug!() não aparecem. Veja docs/modelos-locais.md.
# OREIA_SECA_LLM_DEBUG=1
# RUST_LOG=oreia_llm=debug,info

# ── Forgejo ──────────────────────────────────────────────────────────────────
FORGEJO_DB_PASSWORD=
FORGEJO_WEBHOOK_SECRET=
# Você, o dono e revisor. O bootstrap cria o usuário e o token.
FORGEJO_OWNER_USER=dono
FORGEJO_OWNER_EMAIL=dono@oreia-seca.local
FORGEJO_OWNER_PASSWORD=
FORGEJO_OWNER_TOKEN=

# ── Tokens dos agentes (gerados pelo bootstrap) ─────────────────────────────
AGENT_DEV_BACK_TOKEN=
AGENT_DEV_FRONT_TOKEN=
AGENT_REVIEWER_TOKEN=
