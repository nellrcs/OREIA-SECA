# ─── OREIASECA — Variáveis de ambiente ─────────────────────────────────
# Copie este arquivo para .env e preencha os valores

# Telegram Bot (obtenha via @BotFather no Telegram)
TELEGRAM_TOKEN=
TELEGRAM_ALLOWED=

# Gemini API (obtenha em https://aistudio.google.com/apikey)
GEMINI_KEY=

# OpenRouter API (obtenha em https://openrouter.ai/keys)
OPENROUTER_KEY=

# LM Studio API Base URL (padrão: http://localhost:1234. No Docker, use http://host.docker.internal:1234)
LMSTUDIO_URL=http://localhost:1234
