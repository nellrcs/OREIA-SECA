# ─────────────────────────────────────────────────────────────────────────────
# Segredos do OREIA-SECA. Copie para .env (o `make bootstrap` faz isso e preenche
# o que dá para gerar sozinho). NUNCA faça commit do .env.
# ─────────────────────────────────────────────────────────────────────────────

# Telegram (crie o bot com o @BotFather)
TELEGRAM_TOKEN=
# Seu ID numérico; se não souber, mande uma mensagem ao bot e ele responde com o ID
TELEGRAM_ALLOWED=

# Token Bearer da API REST (/api/*). Gerado pelo bootstrap.
REST_API_KEY=

# ── LLM externo ──────────────────────────────────────────────────────────────
# Preenchido por "make llm-setup" (assistente interativo). Aponta para um
# servidor compatível com /v1/chat/completions rodando em outra máquina, no
# seu computador (LM Studio) ou numa API (OpenRouter) — veja docs/modelos-locais.md.
# LLM_CODER_URL=http://<ip>:11434/v1       # usado por planner, dev-*, executor
# LLM_CODER_MODEL=qwen2.5-coder:14b
# LLM_CHAT_URL=http://<ip>:11434/v1        # usado pela conversa direta (direct)
# LLM_CHAT_MODEL=llama3.1:8b
# LLM_API_KEY=                             # só se o servidor exigir (OpenRouter, etc.)

# Modelos remotos (opcionais, para exemplos específicos em oreia-seca.example.toml)
OPENROUTER_KEY=
GEMINI_KEY=

# ── Forgejo ──────────────────────────────────────────────────────────────────
FORGEJO_DB_PASSWORD=
FORGEJO_WEBHOOK_SECRET=
# Você, o dono e revisor. O bootstrap cria o usuário e o token.
FORGEJO_OWNER_USER=dono
FORGEJO_OWNER_EMAIL=dono@oreia-seca.local
FORGEJO_OWNER_PASSWORD=
FORGEJO_OWNER_TOKEN=

# ── Tokens dos agentes (gerados pelo bootstrap) ─────────────────────────────
AGENT_DEV_BACK_TOKEN=
AGENT_DEV_FRONT_TOKEN=
AGENT_REVIEWER_TOKEN=
